<script>
function validate() {
  let ok = true;
  const chk = (id, eid, cond) => {
    const el = document.getElementById(id), er = document.getElementById(eid);
    if (!cond) { el.classList.add('err'); er.style.display = 'block'; ok = false; }
    else { el.classList.remove('err'); er.style.display = 'none'; }
  };
  chk('acc-name','err-name', !!document.getElementById('acc-name').value.trim());
  chk('bank-sel','err-bank', !!document.getElementById('bank-sel').value);
  chk('acc-num','err-num', document.getElementById('acc-num').value.trim().length >= 4);
  return ok;
}

let _meta = {};

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, char => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#039;'
  })[char]);
}

function fitText(ctx, text, maxWidth) {
  let value = String(text);
  if (ctx.measureText(value).width <= maxWidth) return value;
  while (value.length > 3 && ctx.measureText(value + '...').width > maxWidth) {
    value = value.slice(0, -1);
  }
  return value + '...';
}

function generate() {
  if (!validate()) return;
  const name    = document.getElementById('acc-name').value.trim();
  const bankVal = document.getElementById('bank-sel').value;
  const [swift, bankName] = bankVal.split('|');
  const accNum  = document.getElementById('acc-num').value.trim();
  const amount  = document.getElementById('amount').value;
  const remarks = document.getElementById('remarks').value.trim();

  const parsedAmount = amount && parseFloat(amount) > 0 ? parseFloat(amount).toFixed(2) : '';
  const bankData = {
    accountNumber: accNum,
    accountName: name,
    bankCode: swift
  };
  if (parsedAmount) bankData.amount = parsedAmount;
  if (remarks) bankData.remarks = remarks;

  const qrStr = JSON.stringify(bankData);

  // Render QR
  const div = document.getElementById('qr-div');
  div.innerHTML = '';
  new QRCode(div, { text: qrStr, width: 210, height: 210, colorDark: '#1A1A1A', colorLight: '#FFFFFF', correctLevel: QRCode.CorrectLevel.M });

  // Badge
  document.getElementById('qr-badge').innerHTML = '<span class="qr-badge fp">Bank QR Generator</span>';

  // Info
  let html = `
    <div class="ir"><span class="lbl">Name</span><span class="val">${escapeHTML(name)}</span></div>
    <div class="ir"><span class="lbl">Bank</span><span class="val">${escapeHTML(bankName)}</span></div>
    <div class="ir"><span class="lbl">Account</span><span class="val">${escapeHTML(accNum)}</span></div>
    <div class="ir"><span class="lbl">Bank Code</span><span class="val">${escapeHTML(swift)}</span></div>`;
  if (parsedAmount)
    html += `<div class="ir"><span class="lbl">Amount</span><span class="val amt">Rs. ${parseFloat(parsedAmount).toLocaleString('en-NP',{minimumFractionDigits:2})}</span></div>`;
  if (remarks)
    html += `<div class="ir"><span class="lbl">Remarks</span><span class="val">${escapeHTML(remarks)}</span></div>`;
  document.getElementById('qr-info').innerHTML = html;

  document.getElementById('qr-empty').style.display = 'none';
  const res = document.getElementById('qr-result');
  res.style.display = 'flex';
  res.style.animation = 'none';
  requestAnimationFrame(() => res.style.animation = '');

  _meta = { name, bankName, accNum, swift, amount: parsedAmount, remarks };
}

function downloadQR() {
  const canvas = document.querySelector('#qr-div canvas');
  if (!canvas) return;
  const size = 450, qrSize = 280, qrX = 85, qrY = 40;
  const out = document.createElement('canvas');
  out.width = size; out.height = 650;
  const ctx = out.getContext('2d');

  const gradient = ctx.createLinearGradient(0, 0, 0, out.height);
  gradient.addColorStop(0, '#FDFCF8');
  gradient.addColorStop(1, '#F1EDE4');
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, out.width, out.height);

  ctx.strokeStyle = '#D5CFC5';
  ctx.lineWidth = 2;
  ctx.strokeRect(10, 10, out.width - 20, out.height - 20);

  ctx.shadowColor = 'rgba(26, 26, 26, 0.12)';
  ctx.shadowBlur = 16;
  ctx.shadowOffsetY = 6;
  ctx.fillStyle = '#FFFFFF';
  ctx.fillRect(qrX - 10, qrY - 10, qrSize + 20, qrSize + 20);

  ctx.shadowColor = 'transparent';
  ctx.shadowBlur = 0;
  ctx.shadowOffsetY = 0;
  ctx.drawImage(canvas, qrX, qrY, qrSize, qrSize);

  const headerY = qrY + qrSize + 50;
  ctx.fillStyle = '#E8281B';
  ctx.fillRect(30, headerY - 35, out.width - 60, 50);

  ctx.fillStyle = '#FFFFFF';
  ctx.textAlign = 'center';
  ctx.font = 'bold 22px Arial, sans-serif';
  ctx.fillText('ACCOUNT INFORMATION', out.width / 2, headerY - 10);

  const detailsY = headerY + 40;
  const lineHeight = 31;
  const detailHeight = _meta.amount || _meta.remarks ? 190 : 158;

  ctx.fillStyle = '#FFFFFF';
  ctx.fillRect(30, detailsY - 10, out.width - 60, detailHeight);
  ctx.strokeStyle = '#D5CFC5';
  ctx.lineWidth = 1;
  ctx.strokeRect(30, detailsY - 10, out.width - 60, detailHeight);

  const rows = [
    ['Account Holder', _meta.name || ''],
    ['Bank Name', _meta.bankName || ''],
    ['Account Number', _meta.accNum || ''],
    ['Bank Code', _meta.swift || '']
  ];
  if (_meta.amount) rows.push(['Amount (NPR)', parseFloat(_meta.amount).toFixed(2)]);
  if (_meta.remarks) rows.push(['Remarks', _meta.remarks]);

  rows.forEach(([label, value], index) => {
    const y = detailsY + 18 + index * lineHeight;
    ctx.textAlign = 'left';
    ctx.font = 'bold 14px Arial, sans-serif';
    ctx.fillStyle = '#E8281B';
    ctx.fillText(label + ':', 50, y);

    ctx.font = '15px Arial, sans-serif';
    ctx.fillStyle = '#1A1A1A';
    ctx.fillText(fitText(ctx, value, 210), 190, y);
  });

  ctx.textAlign = 'center';
  ctx.font = '12px Arial, sans-serif';
  ctx.fillStyle = '#6B6660';
  ctx.fillText('Scan QR code for bank fund transfer', out.width / 2, out.height - 32);

  const now = new Date();
  const timestamp = now.toLocaleDateString() + ' ' + now.toLocaleTimeString();
  ctx.fillText(`Generated on: ${timestamp}`, out.width / 2, out.height - 16);

  const a = document.createElement('a');
  a.download = `NepalQR_${(_meta.name||'transfer').replace(/\s+/g,'_')}_${_meta.accNum || 'account'}.png`;
  a.href = out.toDataURL('image/png');
  a.click();
}
</script>
</body>
</html>
